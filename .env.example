# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
POSTGRES_USER=punerecpip
POSTGRES_PASSWORD=change_me
POSTGRES_DB=punerecpip
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async URL used by the API and workers (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://punerecpip:change_me@localhost:5432/punerecpip

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (MinIO in dev / S3-compatible in prod) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=punerecpip-artifacts
OBJECT_STORAGE_ACCESS_KEY=change_me
OBJECT_STORAGE_SECRET_KEY=change_me

# --- Search ---
ELASTICSEARCH_URL=http://localhost:9200

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Auth ---
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Observability ---
SENTRY_DSN=
ENVIRONMENT=development
