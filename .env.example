# Copy to .env and fill in real values. Never commit the real .env file.

# --- Database ---
POSTGRES_USER=punerecpip
POSTGRES_PASSWORD=change_me
POSTGRES_DB=punerecpip
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Async URL used by the API and workers (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://punerecpip:change_me@localhost:5432/punerecpip

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (crawl artifacts: HTML/markdown/screenshots) ---
# "local" writes under OBJECT_STORAGE_LOCAL_DIR, no external service needed —
# the default for dev. Switch to "s3" for MinIO (self-hosted) or AWS S3 (prod);
# leave OBJECT_STORAGE_ENDPOINT_URL unset for real AWS S3, set it to your MinIO
# endpoint otherwise.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_DIR=./.data/object-storage
OBJECT_STORAGE_BUCKET=punerecpip-artifacts
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=change_me
OBJECT_STORAGE_SECRET_KEY=change_me

# --- Discovery (Module 3) ---
DISCOVERY_REQUEST_TIMEOUT_SECONDS=15.0
DISCOVERY_MAX_RETRIES=3
DISCOVERY_DEFAULT_REQUESTS_PER_SECOND=0.5

# --- Crawling (Module 4) ---
# Leave unset to let Playwright resolve its own managed browser install; set
# only if pinning a specific pre-installed Chromium binary (see
# docs/modules/04-crawling.md).
CHROMIUM_EXECUTABLE_PATH=
CRAWL_PAGE_TIMEOUT_SECONDS=20.0
CRAWL_MAX_CONCURRENT_PAGES=3
CRAWL_MAX_PAGES_PER_COMPANY=6
CRAWL_DEFAULT_REQUESTS_PER_SECOND=0.5
CRAWL_MAX_RETRIES=2

# --- AI Enrichment (Module 5) ---
# "claude" (tool-use structured extraction) or "openai" (structured outputs).
# Embeddings always use OpenAI (text-embedding-3-small) regardless of this
# setting — Anthropic has no public embeddings endpoint.
ENRICHMENT_PROVIDER=claude
ENRICHMENT_CLAUDE_MODEL=claude-sonnet-5
ENRICHMENT_OPENAI_MODEL=gpt-4o-mini
ENRICHMENT_EMBEDDING_MODEL=text-embedding-3-small
ENRICHMENT_MAX_RETRIES=3
ENRICHMENT_MAX_CONTENT_CHARS=24000

# --- Search ---
ELASTICSEARCH_URL=http://localhost:9200

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Auth ---
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Observability ---
SENTRY_DSN=
ENVIRONMENT=development
